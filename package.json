  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --webpack",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "mock:exercise": "python scripts/generate-exercise-mock.py",
    "sync:exercise": "tsx scripts/sync-exercise.ts",
    "validate:sync": "tsx scripts/validate-sync.ts",
    "test:exercise": "tsx scripts/validate-exercise-logic.ts",
    "doc:fonctionnel": "node scripts/generate-fonctionnel-doc.mjs",
    "test": "npm run lint && npm run test:exercise && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
