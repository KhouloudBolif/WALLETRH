# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/rh_annexe?schema=public"

# NextAuth v5 — use: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Optional: separate key for encrypting admin-visible passwords (defaults to AUTH_SECRET)
# ENCRYPTION_KEY=

# Google Apps Script Drive sync — shared HMAC secret (use: openssl rand -base64 32).
# Must match the SYNC_SECRET Script Property set in the Apps Script project.
# Generate a distinct value per environment (never reuse staging's in prod).
DRIVE_SYNC_WEBHOOK_SECRET=

# Apps Script ZIP-export bridge — the Web App URL from deploying doPost(e) in
# scripts/apps-script/sync.gs (Deploy > New deployment > Web app). Signed with
# the same DRIVE_SYNC_WEBHOOK_SECRET above. See doc/APPS_SCRIPT_SYNC_SETUP.md.
APPS_SCRIPT_EXPORT_URL=

# ─── Real emails (SMTP) ───────────────────────────────────────────────
# Gmail SMTP
#   1. Enable 2-Step Verification on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character password as SMTP_PASS (not your Gmail password)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Portail RH <your.email@gmail.com>"
#
